{
  "name": "gestion-ganadera",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build:site": "turbo run build --filter=@ganaderia/landing --filter=@ganaderia/web",
    "start": "pnpm build:site && pnpm --filter @ganaderia/api start"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
