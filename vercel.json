{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "corepack enable && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:site && node scripts/vercel-prepare.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "apps/api/migrations/**"
    }
  },
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api" },
    { "source": "/app/((?!assets/|art/)[^.]*)", "destination": "/app/index.html" }
  ],
  "redirects": [{ "source": "/app", "destination": "/app/", "permanent": false }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    { "source": "/app/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/app/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    {
      "source": "/app/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
